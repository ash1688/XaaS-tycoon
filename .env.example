# Copy to .env.local for local development, or to .env for `npm run serve` (git ignores both).
# 127.0.0.1, not localhost: on Windows localhost is IPv6 first, and Docker Desktop's IPv6 port forwarding adds about
# 45 ms to every Continue (any query over 16 KB).
DATABASE_URL=postgres://xaas:xaas@127.0.0.1:5433/xaas
TEACHER_PASSWORD=change-me
SESSION_SECRET=a-long-random-string-at-least-32-chars
PORT=3080
# Optional: end games after this many days instead of the default 180, for trying out the end of a game.
# GAME_FINAL_DAY=10
# Optional: timed flow. With TIMED_FLOW=on the game page gets Play/Pause and plays a day every TIMED_FLOW_SECONDS
# (default 10) instead of only the Continue button. Off unless set; the alpha plays a day per Continue click.
# TIMED_FLOW=on
# TIMED_FLOW_SECONDS=10
# Optional: behind a reverse proxy (Dokploy's Traefik), the proxy addresses to trust for the client's IP and HTTPS,
# so the teacher cookie is Secure and rate limits see each client. docker-compose.prod.yml sets uniquelocal.
# TRUST_PROXY=uniquelocal
# Optional: failed student code lookups (RATE_LIMIT_CODE_FAILURES, default 100) and wrong teacher passwords
# (RATE_LIMIT_LOGIN_FAILURES, default 10) allowed per client IP in RATE_LIMIT_WINDOW_MINUTES (default 15).
# RATE_LIMIT_CODE_FAILURES=100
# RATE_LIMIT_LOGIN_FAILURES=10
# RATE_LIMIT_WINDOW_MINUTES=15
# Production only (docker-compose.prod.yml builds DATABASE_URL from it). Letters and digits only.
# POSTGRES_PASSWORD=
